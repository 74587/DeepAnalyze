# Docker is the safe default. Local mode requires an explicit unsafe opt-in.
DEEPANALYZE_EXECUTION_MODE=docker
DEEPANALYZE_ALLOW_UNSAFE_LOCAL_EXECUTION=false

# Per-run execution timeout in seconds
DEEPANALYZE_EXECUTION_TIMEOUT_SEC=120

# Service ports
DEEPANALYZE_BACKEND_PORT=9000
DEEPANALYZE_FILE_SERVER_PORT=8100
FRONTEND_PORT=4000

# Docker execution settings
# The bundled execution image is built automatically when it is missing.
# Set this to false when images are managed by an external deployment pipeline.
DEEPANALYZE_DOCKER_AUTO_BUILD=true
DEEPANALYZE_DOCKER_IMAGE=deepanalyze-chat-exec:latest

# Prefix used for per-session container names
DEEPANALYZE_DOCKER_CONTAINER_NAME=deepanalyze-chat-exec
DEEPANALYZE_DOCKER_SESSION_IDLE_TTL_SEC=1800
DEEPANALYZE_DOCKER_WORKSPACE_DIR=/workspace
DEEPANALYZE_DOCKER_PYTHON_BIN=python
DEEPANALYZE_DOCKER_STOP_ON_SHUTDOWN=true
DEEPANALYZE_DOCKER_NETWORK_MODE=none
DEEPANALYZE_DOCKER_MEMORY=1g
DEEPANALYZE_DOCKER_CPUS=1.0
DEEPANALYZE_DOCKER_PIDS_LIMIT=256
DEEPANALYZE_DOCKER_USER=1000:1000
DEEPANALYZE_DOCKER_READ_ONLY=true
DEEPANALYZE_DOCKER_TMPFS_SIZE=256m

# Upload and per-session workspace limits
DEEPANALYZE_UPLOAD_MAX_FILE_BYTES=104857600
DEEPANALYZE_WORKSPACE_MAX_BYTES=1073741824
DEEPANALYZE_WORKSPACE_MAX_FILES=500
DEEPANALYZE_UPLOAD_CHUNK_BYTES=1048576

# Agent loop budgets
DEEPANALYZE_CHAT_MAX_ROUNDS=12
DEEPANALYZE_CHAT_MAX_DURATION_SEC=900
DEEPANALYZE_CHAT_MAX_RESPONSE_CHARS=1000000
DEEPANALYZE_MODEL_STREAM_READ_TIMEOUT_SEC=60
DEEPANALYZE_EXECUTION_OUTPUT_MAX_CHARS=32768

# Disabled by default. Enable only for a trusted local demo when remote file
# previews are required; this endpoint is not intended to be a public proxy.
DEEPANALYZE_ENABLE_EXTERNAL_PROXY=false

# Optional: force a CJK main font for PDF export (used when report contains Chinese)
# DEEPANALYZE_PDF_CJK_MAINFONT=SimHei

# Optional: auto-download pandoc when it is not found in PATH (default: true)
# DEEPANALYZE_PDF_AUTO_DOWNLOAD_PANDOC=true

# Optional: custom cache directory for downloaded pandoc binaries
# DEEPANALYZE_PDF_PANDOC_CACHE_DIR=workspace/.tools/pandoc
